<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="category_compensation_form" model="ir.ui.view">
        <field name="name">category.compensation.form</field>
        <field name="model">category.compensation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>

        </field>
    </record>

    <record id="category_compensation_list" model="ir.ui.view">
        <field name="name">category.compensation.list</field>
        <field name="model">category.compensation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_category_compensation" model="ir.actions.act_window">
        <field name="name">category compensation</field>
        <field name="res_model">category.compensation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>