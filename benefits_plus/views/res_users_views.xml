<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_users_form_inherit_benefits" model="ir.ui.view">
        <field name="name">res.users.form.inherit.benefits</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']//group[last()]" position="after">
                <group string="Дополнительные права (Benefits)">
                    <!-- Исправленный домен без функции ref() -->
                    <field name="group_ids"
                           widget="many2many_checkboxes"
                           domain="[('id', '=', %(benefits_plus.group_benefits_manager)d)]"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
