<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="edit_total_compensation_form" model="ir.ui.view">
        <field name="name">edit.total.compensation.form</field>
        <field name="model">edit.total.compensation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <div style="color:red; size:24px">Total:<field name="selected_count"/></div>
                </header>
                <group>
                    <field name="edit_total"/>
                </group>
                <footer>
                    <button name="submit_edit_total_employee" string="Confirm" type="object" class="btn_primary"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>