<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_send_daily_reminder" model="ir.cron">
            <field name="name">Daily add benefits employees</field>
            <field name="active">True</field>
            <field name="priority">5</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="model_id" ref="model_benefits_dashboard"/>
            <field name="nextcall" eval="(datetime.utcnow().replace(day=1, hour=8, minute=0, second=0) + relativedelta(months=1))"/>

<!--            <field name="nextcall" eval="(datetime.now().replace(day=1, hour=8, minute=0, second=0, microsecond=0) + relativedelta(months=1))"/>-->
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._add_benefits_employee()</field>
        </record>
    </data>
</odoo>
